<script>


/* =====================================================
   GLOBAL VARIABLES
===================================================== */

let mediaStream = null;

let audioContext = null;

let analyser = null;

let recognition = null;

let currentQuestion = 0;

let selectedAnswer = null;

let answers = [];

let interviewStartTime = 0;

let faceSamples = 0;

let faceDetectedSamples = 0;

let movementTotal = 0;

let lastFaceX = null;

let lastFaceY = null;

let audioSamples = 0;

let voiceSamples = 0;

let demoMode = false;

let speechSupported = false;


/* =====================================================
   QUESTIONS
===================================================== */

const questions = [

{

question:
"An AI can complete a programming task faster than you. Why should a company still hire you?",

category:"adaptability",

options:[

"I can learn, understand requirements and make decisions.",

"AI cannot replace humans completely.",

"I would just use AI for everything.",

"I don't know."

]

},

{

question:
"Your production application suddenly stops working. What do you do first?",

category:"problem",

options:[

"Understand the error, check logs and identify the root cause.",

"Restart everything immediately.",

"Ask someone else to fix it.",

"Wait and see if it fixes itself."

]

},

{

question:
"You have to learn a completely new technology in 48 hours. What is your approach?",

category:"adaptability",

options:[

"Understand the fundamentals, build something small and practice.",

"Watch tutorials for two days.",

"Memorize the syntax.",

"Avoid it if possible."

]

},

{

question:
"A teammate strongly disagrees with your technical solution. What do you do?",

category:"communication",

options:[

"Discuss both approaches and compare them using evidence.",

"Explain why my solution is better.",

"Let the manager decide.",

"Ignore the disagreement."

]

},

{

question:
"Your company gives you an AI tool you have never used before. What would you do?",

category:"ai",

options:[

"Experiment with it, understand its limitations and find useful applications.",

"Learn it only when necessary.",

"Use it without checking its output.",

"Avoid using it."

]

}

];


/* =====================================================
   ANSWER SCORES
===================================================== */

const answerScores = [

[10,6,2,1],

[10,5,3,1],

[10,6,4,1],

[10,6,4,1],

[10,6,3,1]

];


/* =====================================================
   PAGE NAVIGATION
===================================================== */

function hideAll(){

    document
    .querySelectorAll("section")
    .forEach(function(section){

        section.classList.add("hidden");

    });

}


function showSection(id){

    hideAll();

    document
    .getElementById(id)
    .classList.remove("hidden");

}


/* =====================================================
   START
===================================================== */

document
.getElementById("startButton")
.addEventListener(
"click",
function(){

    showSection("profile");

});


/* =====================================================
   PROFILE
===================================================== */

document
.getElementById("profileContinue")
.addEventListener(
"click",
function(){

    const name =
    document
    .getElementById("candidateName")
    .value
    .trim();


    if(!name){

        alert(
        "Please enter your name."
        );

        return;

    }


    showSection("permission");

});


/* =====================================================
   CAMERA + MICROPHONE
===================================================== */

document
.getElementById("enableMediaButton")
.addEventListener(
"click",
enableMedia
);


async function enableMedia(){

    const status =
    document
    .getElementById(
        "permissionStatus"
    );


    status.innerText =
    "Requesting camera and microphone permission...";


    try{


        /*
        CHECK CAMERA SUPPORT
        */

        if(
        !navigator.mediaDevices ||
        !navigator.mediaDevices.getUserMedia
        ){

            throw new Error(
            "Camera API unavailable."
            );

        }


        /*
        REQUEST MEDIA
        */

        mediaStream =
        await navigator
        .mediaDevices
        .getUserMedia({

            video:{
                facingMode:"user",
                width:{ideal:640},
                height:{ideal:480}
            },

            audio:true

        });


        /*
        CAMERA
        */

        const video =
        document
        .getElementById(
            "video"
        );


        video.srcObject =
        mediaStream;


        document
        .getElementById(
            "cameraPlaceholder"
        )
        .style.display =
        "none";


        /*
        AUDIO
        */

        setupAudio();


        status.innerText =
        "✓ Camera and microphone connected.";


        demoMode = false;


        startInterviewSession();


    }

    catch(error){

        console.warn(
        "Camera/microphone error:",
        error
        );


        /*
        IMPORTANT:
        DON'T BREAK THE WEBSITE.

        SWITCH TO DEMO MODE.
        */

        demoMode = true;


        status.innerHTML =

        "<b>DEMO MODE</b><br><br>" +

        "Camera or microphone cannot be accessed " +

        "in this preview environment.<br><br>" +

        "The interview will continue normally.";


        setTimeout(
        function(){

            startInterviewSession();

        },
        700
        );

    }

}


/* =====================================================
   START INTERVIEW
===================================================== */

function startInterviewSession(){

    showSection("interview");


    currentQuestion = 0;

    selectedAnswer = null;

    answers = [];


    interviewStartTime =
    Date.now();


    showQuestion();


    if(mediaStream){

        startAudioAnalysis();

    }


    /*
    FACE ANALYSIS
    Only starts if browser supports
    FaceDetector.

    If not available,
    the website continues normally.
    */

    startFaceDetection();

}


/* =====================================================
   AUDIO SETUP
===================================================== */

function setupAudio(){

    try{

        const AudioContext =
        window.AudioContext ||
        window.webkitAudioContext;


        if(!AudioContext){

            return;

        }


        audioContext =
        new AudioContext();


        const source =
        audioContext
        .createMediaStreamSource(
            mediaStream
        );


        analyser =
        audioContext
        .createAnalyser();


        analyser.fftSize =
        512;


        source.connect(
            analyser
        );

    }

    catch(error){

        console.warn(
        "Audio setup failed:",
        error
        );

    }

}


/* =====================================================
   AUDIO ANALYSIS
===================================================== */

function startAudioAnalysis(){

    if(!analyser){

        return;

    }


    const data =
    new Uint8Array(
        analyser.fftSize
    );


    function analyze(){

        analyser
        .getByteTimeDomainData(
            data
        );


        let sum = 0;


        for(
        let i=0;
        i<data.length;
        i++
        ){

            const value =
            (data[i]-128)/128;


            sum +=
            value*value;

        }


        const rms =
        Math.sqrt(
            sum/data.length
        );


        audioSamples++;


        if(
        rms > 0.035
        ){

            voiceSamples++;

        }


        const activity =
        audioSamples>0
        ?
        (
            voiceSamples/
            audioSamples
        )*100
        :
        0;


        document
        .getElementById(
            "voiceMetric"
        )
        .innerText =
        Math.round(
            activity
        )+"%";


        const seconds =
        Math.floor(
        (
            Date.now() -
            interviewStartTime
        )/1000
        );


        document
        .getElementById(
            "timeMetric"
        )
        .innerText =
        seconds+"s";


        requestAnimationFrame(
            analyze
        );

    }


    analyze();

}


/* =====================================================
   FACE DETECTION
===================================================== */

function startFaceDetection(){

    /*
    Browser FaceDetector API is not
    available everywhere.

    If unavailable, the project still works.
    */

    if(
    "FaceDetector" in window
    ){

        try{

            const detector =
            new FaceDetector({
                fastMode:true,
                maxDetectedFaces:1
            });


            const video =
            document
            .getElementById(
                "video"
            );


            async function detect(){

                if(
                !demoMode &&
                video.readyState>=2
                ){

                    try{

                        const faces =
                        await detector.detect(
                            video
                        );


                        faceSamples++;


                        if(
                        faces.length>0
                        ){

                            faceDetectedSamples++;


                            /*
                            Approximate face
                            center movement
                            */

                            const box =
                            faces[0].boundingBox;


                            const x =
                            box.x+
                            box.width/2;


                            const y =
                            box.y+
                            box.height/2;


                            if(
                            lastFaceX!==null
                            ){

                                movementTotal +=

                                Math.abs(
                                x-lastFaceX
                                )+

                                Math.abs(
                                y-lastFaceY
                                );

                            }


                            lastFaceX=x;

                            lastFaceY=y;

                        }


                        updateFaceScore();

                    }

                    catch(error){

                        console.warn(
                        "Face detection error",
                        error
                        );

                    }

                }


                requestAnimationFrame(
                    detect
                );

            }


            detect();

        }

        catch(error){

            console.warn(
            "FaceDetector unavailable",
            error
            );

            demoFaceMetrics();

        }

    }

    else{

        /*
        Most Android browsers may not
        provide FaceDetector.

        Use neutral demo values rather
        than pretending the browser
        detected a face.
        */

        demoFaceMetrics();

    }

}


/* =====================================================
   FACE SCORE
===================================================== */

function updateFaceScore(){

    const visibility =
    faceSamples>0
    ?
    (
        faceDetectedSamples/
        faceSamples
    )*100
    :
    0;


    const movement =
    movementTotal/
    Math.max(
        faceSamples,
        1
    );


    const stability =
    Math.max(
        0,
        Math.min(
            100,
            100-(movement/3)
        )
    );


    document
    .getElementById(
        "faceMetric"
    )
    .innerText =
    Math.round(
        visibility
    )+"%";


    document
    .getElementById(
        "headMetric"
    )
    .innerText =
    Math.round(
        stability
    )+"%";


    if(
    faceDetectedSamples>0
    ){

        document
        .getElementById(
            "cameraStatus"
        )
        .innerText =
        "● FACE DETECTED";

    }

}


/* =====================================================
   DEMO FACE METRICS
===================================================== */

function demoFaceMetrics(){

    document
    .getElementById(
        "faceMetric"
    )
    .innerText =
    "N/A";


    document
    .getElementById(
        "headMetric"
    )
    .innerText =
    "N/A";


    document
    .getElementById(
        "cameraStatus"
    )
    .innerText =
    "● DEMO MODE";

}


/* =====================================================
   SHOW QUESTION
===================================================== */

function showQuestion(){

    const q =
    questions[
        currentQuestion
    ];


    selectedAnswer = null;


    document
    .getElementById(
        "questionNumber"
    )
    .innerText =

    "QUESTION " +

    (currentQuestion+1) +

    " / " +

    questions.length;


    document
    .getElementById(
        "question"
    )
    .innerText =
    q.question;


    let html="";


    q.options.forEach(
    function(option,index){

        html +=

        '<div class="option" ' +

        'data-index="'+
        index+
        '">' +

        option +

        '</div>';

    });


    document
    .getElementById(
        "options"
    )
    .innerHTML =
    html;


    document
    .querySelectorAll(
        ".option"
    )
    .forEach(
    function(option){

        option.addEventListener(
        "click",
        function(){

            selectAnswer(
                parseInt(
                    option.dataset.index
                )
            );

        });

    });


    document
    .getElementById(
        "progress"
    )
    .style.width =

    (
        currentQuestion/
        questions.length*
        100
    )+"%";


    document
    .getElementById(
        "transcript"
    )
    .innerText =

    "Press START ANSWER and speak your answer.";

}


/* =====================================================
   SELECT ANSWER
===================================================== */

function selectAnswer(index){

    selectedAnswer =
    index;


    document
    .querySelectorAll(
        ".option"
    )
    .forEach(
    function(option){

        option.classList.remove(
            "selected"
        );

    });


    const selected =
    document
    .querySelector(
        '[data-index="'+
        index+
        '"]'
    );


    if(selected){

        selected.classList.add(
            "selected"
        );

    }

}


/* =====================================================
   SPEECH
===================================================== */

document
.getElementById(
    "voiceButton"
)
.addEventListener(
    "click",
    startVoice
);


document
.getElementById(
    "stopVoiceButton"
)
.addEventListener(
    "click",
    stopVoice
);


function startVoice(){

    const SpeechRecognition =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;


    if(!SpeechRecognition){

        alert(

        "Speech recognition is not supported " +

        "by this browser. You can still select " +

        "your answer and continue."

        );

        return;

    }


    try{

        recognition =
        new SpeechRecognition();


        recognition.continuous =
        true;


        recognition.interimResults =
        true;


        recognition.lang =
        "en-IN";


        recognition.onresult =
        function(event){

            let text="";


            for(
            let i=event.resultIndex;
            i<event.results.length;
            i++
            ){

                text +=

                event.results[i][0]
                .transcript;

            }


            document
            .getElementById(
                "transcript"
            )
            .innerText =
            text;

        };


        recognition.onerror =
        function(event){

            console.warn(
            "Speech error:",
            event.error
            );

        };


        recognition.start();


        document
        .getElementById(
            "voiceButton"
        )
        .style.display =
        "none";


        document
        .getElementById(
            "stopVoiceButton"
        )
        .style.display =
        "inline-block";

    }

    catch(error){

        console.warn(
        error
        );

    }

}


/* =====================================================
   STOP VOICE
===================================================== */

function stopVoice(){

    if(recognition){

        try{

            recognition.stop();

        }

        catch(error){

            console.log(error);

        }

    }


    document
    .getElementById(
        "voiceButton"
    )
    .style.display =
    "inline-block";


    document
    .getElementById(
        "stopVoiceButton"
    )
    .style.display =
    "none";

}


/* =====================================================
   NEXT QUESTION
===================================================== */

document
.getElementById(
    "nextButton"
)
.addEventListener(
    "click",
    nextQuestion
);


function nextQuestion(){

    if(
    selectedAnswer===null
    ){

        alert(
        "Please select an answer."
        );

        return;

    }


    stopVoice();


    answers[
        currentQuestion
    ] =
    selectedAnswer;


    if(
    currentQuestion <
    questions.length-1
    ){

        currentQuestion++;


        showQuestion();

    }

    else{

        finishInterview();

    }

}


/* =====================================================
   FINISH
===================================================== */

function finishInterview(){

    stopVoice();


    const technical =
    parseInt(
        document
        .getElementById(
            "technicalLevel"
        )
        .value
    );


    const ai =
    parseInt(
        document
        .getElementById(
            "aiLevel"
        )
        .value
    );


    let problem=0;

    let communication=0;

    let adaptability=0;

    let aiQuestion=0;


    let problemCount=0;

    let communicationCount=0;

    let adaptabilityCount=0;

    let aiCount=0;


    questions.forEach(
    function(q,index){

        const answer =
        answers[index];


        const score =
        answerScores[index][answer]
        *10;


        if(
        q.category==="problem"
        ){

            problem+=score;

            problemCount++;

        }


        if(
        q.category==="communication"
        ){

            communication+=score;

            communicationCount++;

        }


        if(
        q.category==="adaptability"
        ){

            adaptability+=score;

            adaptabilityCount++;

        }


        if(
        q.category==="ai"
        ){

            aiQuestion+=score;

            aiCount++;

        }

    });


    problem =
    problemCount
    ?
    problem/problemCount
    :
    50;


    communication =
    communicationCount
    ?
    communication/
    communicationCount
    :
    50;


    adaptability =
    adaptabilityCount
    ?
    adaptability/
    adaptabilityCount
    :
    50;


    /*
    PRESENCE
    */

    let presence;


    if(
    demoMode ||
    faceSamples===0
    ){

        /*
        We don't pretend camera
        analysis happened.
        */

        presence = 50;

    }

    else{

        const face =
        (
            faceDetectedSamples/
            faceSamples
        )*100;


        const movement =
        movementTotal/
        Math.max(
            faceSamples,
            1
        );


        const stability =
        Math.max(
            0,
            Math.min(
                100,
                100-(movement/3)
            )
        );


        const voice =
        audioSamples>0
        ?
        (
            voiceSamples/
            audioSamples
        )*100
        :
        50;


        presence =
        Math.round(

            face*.35+

            stability*.25+

            voice*.40

        );

    }


    /*
    FINAL SCORE
    */

    const finalScore =
    Math.round(

        technical*.20+

        problem*.20+

        communication*.15+

        adaptability*.15+

        ai*.10+

        presence*.20

    );


    /*
    SHOW RESULT
    */

    document
    .getElementById(
        "candidateResult"
    )
    .innerText =

    "Candidate: " +

    document
    .getElementById(
        "candidateName"
    )
    .value;


    document
    .getElementById(
        "finalScore"
    )
    .innerText =
    finalScore;


    document
    .getElementById(
        "technicalScore"
    )
    .innerText =
    technical+"%";


    document
    .getElementById(
        "problemScore"
    )
    .innerText =
    Math.round(
        problem
    )+"%";


    document
    .getElementById(
        "communicationScore"
    )
    .innerText =
    Math.round(
        communication
    )+"%";


    document
    .getElementById(
        "adaptabilityScore"
    )
    .innerText =
    Math.round(
        adaptability
    )+"%";


    document
    .getElementById(
        "aiScore"
    )
    .innerText =

    Math.round(

        (
            ai+
            aiQuestion
        )/2

    )+"%";


    document
    .getElementById(
        "presenceScore"
    )
    .innerText =
    presence+"%";


    /*
    MESSAGE
    */

    let message;


    if(
    finalScore>=85
    ){

        message =
        "EXCELLENT — Your profile shows strong readiness for an AI-driven workplace.";

    }

    else if(
    finalScore>=70
    ){

        message =
        "STRONG POTENTIAL — You are on the right track. Strengthen your weaker areas.";

    }

    else if(
    finalScore>=50
    ){

        message =
        "DEVELOPING — You have a foundation. Focus on communication, problem solving and adaptability.";

    }

    else{

        message =
        "EARLY STAGE — Identify your weakest skills and build them through projects and practice.";

    }


    if(demoMode){

        message +=

        " Camera analysis was unavailable in this session, so Interview Presence was not claimed as a real camera measurement.";

    }


    document
    .getElementById(
        "message"
    )
    .innerText =
    message;


    showSection("result");


    /*
    STOP CAMERA
    */

    if(mediaStream){

        mediaStream
        .getTracks()
        .forEach(
        function(track){

            track.stop();

        });

    }


    if(audioContext){

        try{

            audioContext.close();

        }

        catch(error){}

    }

}


/* =====================================================
   RESTART
===================================================== */

document
.getElementById(
    "restartButton"
)
.addEventListener(
    "click",
    function(){

        location.reload();

    });


</script>

